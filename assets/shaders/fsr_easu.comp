// AMD FidelityFX Super Resolution 1.0 — EASU (upscale) pass.
// Обёртка над официальным ffx_fsr1.h (GPUOpen, MIT).
#version 460
#extension GL_GOOGLE_include_directive : require

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"

layout(set = 0, binding = 0) uniform sampler2D InputTexture;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D OutputTexture;

layout(push_constant) uniform PC {
    uvec4 Const0;
    uvec4 Const1;
    uvec4 Const2;
    uvec4 Const3;
};

#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return AF4(textureGather(InputTexture, p, 0)); }
AF4 FsrEasuGF(AF2 p) { return AF4(textureGather(InputTexture, p, 1)); }
AF4 FsrEasuBF(AF2 p) { return AF4(textureGather(InputTexture, p, 2)); }
#include "ffx_fsr1.h"

layout(local_size_x = 64) in;

void CurrFilter(AU2 pos) {
    AF3 c;
    FsrEasuF(c, pos, Const0, Const1, Const2, Const3);
    imageStore(OutputTexture, ASU2(pos), AF4(c, 1.0));
}

void main() {
    // Стандартный 8x8-remap на 4 квадранта (из официального примера FSR)
    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) +
              AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    CurrFilter(gxy);
    gxy.x += 8u;  CurrFilter(gxy);
    gxy.y += 8u;  CurrFilter(gxy);
    gxy.x -= 8u;  CurrFilter(gxy);
}
